<Ui xmlns="http://www.blizzard.com/wow/ui/" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://www.blizzard.com/wow/ui/
..\FrameXML\UI.xsd">
	<Button name="SpawnscoutPinTemplate" hidden="true" enableMouse="true" mixin="SpawnscoutPinMixin" virtual="true">
		<Size x="16" y="16"/>
		<Layers>
			<Layer level="BACKGROUND">
				<Texture parentKey="Ring" setAllPoints="true">
					<Color r="0" g="0" b="0" a="0.85"/>
				</Texture>
				<MaskTexture parentKey="RingMask" file="Interface\CharacterFrame\TempPortraitAlphaMask" hWrapMode="CLAMPTOBLACKADDITIVE" vWrapMode="CLAMPTOBLACKADDITIVE">
					<Anchors>
						<Anchor point="TOPLEFT" relativeKey="$parent.Ring"/>
						<Anchor point="BOTTOMRIGHT" relativeKey="$parent.Ring"/>
					</Anchors>
					<MaskedTextures>
						<MaskedTexture childKey="Ring"/>
					</MaskedTextures>
				</MaskTexture>
			</Layer>
			<Layer level="ARTWORK">
				<Texture parentKey="Dot">
					<Size x="12" y="12"/>
					<Anchors>
						<Anchor point="CENTER"/>
					</Anchors>
					<Color r="1" g="1" b="1" a="1"/>
				</Texture>
				<MaskTexture parentKey="DotMask" file="Interface\CharacterFrame\TempPortraitAlphaMask" hWrapMode="CLAMPTOBLACKADDITIVE" vWrapMode="CLAMPTOBLACKADDITIVE">
					<Anchors>
						<Anchor point="TOPLEFT" relativeKey="$parent.Dot"/>
						<Anchor point="BOTTOMRIGHT" relativeKey="$parent.Dot"/>
					</Anchors>
					<MaskedTextures>
						<MaskedTexture childKey="Dot"/>
					</MaskedTextures>
				</MaskTexture>
			</Layer>
		</Layers>
	</Button>
</Ui>
